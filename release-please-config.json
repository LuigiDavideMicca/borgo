{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bump-minor-pre-major": true,
  "packages": {
    "packages/borgo": {
      "release-type": "node",
      "component": "borgo-framework",
      "include-component-in-tag": false
    },
    "packages/create-borgo": {
      "release-type": "node",
      "component": "create-borgo"
    }
  },
  "plugins": [
    {
      "type": "linked-versions",
      "groupName": "borgo",
      "components": [
        "borgo-framework",
        "create-borgo"
      ]
    }
  ]
}
