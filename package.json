{
  "name": "borgo-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "typecheck": "cd packages/borgo && bunx tsc --noEmit && cd ../create-borgo && bunx tsc --noEmit && cd ../../examples/tasks && bunx tsc --noEmit",
    "test": "bun test packages/borgo/test packages/create-borgo/test",
    "test:go": "go test ./...",
    "e2e": "playwright test",
    "bench": "bun bench/run.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0"
  }
}
