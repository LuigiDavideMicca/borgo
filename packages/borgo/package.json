{
  "name": "borgo-framework",
  "version": "0.22.0",
  "description": "The self-hosted React framework: file-based React SSR on Bun, API routes in Go, typed end to end. Vercel DX, Go performance, no platform lock-in.",
  "type": "module",
  "bin": {
    "borgo": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./internal": "./src/internal.ts",
    "./refresh-runtime": "./src/refresh-runtime.ts",
    "./router": "./src/router.ts",
    "./runtime": "./src/runtime.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "dependencies": {
    "@babel/core": "^7.26.0",
    "sass-embedded": "^1.93.0",
    "react-refresh": "^0.18.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.0",
    "@types/bun": "^1.4.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^7.0.2"
  },
  "author": "Luigi Davide Micca <luigimicca94@gmail.com> (https://luigimicca.com)",
  "license": "MIT",
  "homepage": "https://github.com/LuigiDavideMicca/borgo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LuigiDavideMicca/borgo.git",
    "directory": "packages/borgo"
  },
  "keywords": [
    "react",
    "ssr",
    "go",
    "golang",
    "bun",
    "framework",
    "fullstack",
    "self-hosted",
    "typescript",
    "code-generation",
    "file-based-routing",
    "islands",
    "websockets",
    "sse",
    "fast-refresh",
    "nextjs-alternative"
  ]
}
